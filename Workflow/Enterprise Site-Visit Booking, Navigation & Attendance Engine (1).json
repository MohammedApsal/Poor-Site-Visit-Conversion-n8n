    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst b = $input.item.json.body || {};\nconst headers = $input.item.json.headers || {};\nconst apiKey = headers['x-api-key'] || '';\nconst authOk = !process.env.BOOKING_API_KEY || apiKey === process.env.BOOKING_API_KEY;\n\nconst required = ['request_id', 'lead_phone', 'rep_id', 'project_id', 'proposed_time'];\nconst missing = required.filter(k => !b[k]);\n\nlet phone = String(b.lead_phone || '').replace(/[^0-9+]/g, '');\nif (phone.length === 10) phone = '+91' + phone;\nelse if (!phone.startsWith('+') && phone.length > 10) phone = '+' + phone;\n\nreturn {\n  json: {\n    ...b,\n    lead_phone: phone,\n    auth_ok: authOk,\n    valid: authOk && missing.length === 0,\n    missing\n  }\n};"
      },
