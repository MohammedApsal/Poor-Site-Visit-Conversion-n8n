      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO sitevisits.site_visits (\n  lead_phone, lead_email, lead_name, rep_id, project_id, scheduled_at, status\n)\nSELECT $1, $2, $3, $4, $5, $6::timestamptz, 'pending_confirmation'\nWHERE NOT EXISTS (\n  SELECT 1 FROM sitevisits.site_visits\n  WHERE rep_id = $4\n    AND status NOT IN ('cancelled', 'no_show')\n    AND scheduled_at BETWEEN $6::timestamptz - interval '45 minutes'\n                         AND $6::timestamptz + interval '45 minutes'\n)\nRETURNING id;",
        "options": {
          "queryReplacement": "={{ [\n  $('Validate + Authenticate').first().json.lead_phone,\n  $('Validate + Authenticate').first().json.lead_email,\n  $('Validate + Authenticate').first().json.lead_name || 'Valued Buyer',\n  $('Validate + Authenticate').first().json.rep_id,\n  $('Validate + Authenticate').first().json.project_id,\n  $('Validate + Authenticate').first().json.proposed_time\n] }}"
        }
