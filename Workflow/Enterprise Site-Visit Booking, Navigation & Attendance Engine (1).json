    {
      "parameters": {
        "jsCode": "const booking = $input.first().json;\nconst meta = $('Get Lead / Project').first().json;\nconst auth = $('Validate + Authenticate').first().json;\n\nconst lat = meta.site_lat || '12.9716';\nconst lng = meta.site_lng || '77.5946';\n\nconst mapsUrl = `https://www.google.com/maps/dir/?api=1&destination=${lat},${lng}&travelmode=driving`;\nconst gatePassCode = 'VP-' + Math.random().toString(36).slice(2, 8).toUpperCase();\nconst driverText = `🚗 SITE VISIT: ${meta.project_name}\\nDate & Time: ${auth.proposed_time}\\nSecurity Pass: ${gatePassCode}\\nAddress: ${meta.site_address}\\nDirections: ${mapsUrl}`;\n\nreturn {\n  json: {\n    visit_id: booking.id,\n    request_id: auth.request_id,\n    lead_name: auth.lead_name || 'Valued Buyer',\n    lead_phone: auth.lead_phone,\n    lead_email: auth.lead_email || null,\n    project_id: auth.project_id,\n    project_name: meta.project_name,\n    site_address: meta.site_address,\n    rep_name: meta.rep_name,\n    rep_phone: meta.rep_phone,\n    rep_email: meta.rep_email,\n    slack_user_id: meta.slack_user_id,\n    proposed_time: auth.proposed_time,\n    gate_pass_code: gatePassCode,\n    maps_url: mapsUrl,\n    driver_share_text: driverText\n  }\n};"
      },
